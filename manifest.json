{
  "manifest_version": 3,
  "name": "Focus Your Time",
  "description": "Hiển thị thời gian duyệt web theo domain trong ngày (reset 7:00).",
  "version": "1.1.0",
  "incognito": "spanning",
  "permissions": ["storage", "tabs", "windows", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Focus Your Time"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/overlay.ts"],
      "run_at": "document_start"
    }
  ]
}
