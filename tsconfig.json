{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["chrome", "node", "vite/client"]
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
